{
  "expo": {
    "name": "FactoryPulse",
    "slug": "factorypulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f1923"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.factorypulse.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1923"
      },
      "package": "com.factorypulse.mobile"
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "factorypulse"
  }
}
